# Copy this file to server/.env (or a .env at the project root) and fill in what you use. Never commit the real file.
# Without these, reset codes and other messages are only saved to the outbox (and printed in the console during development).

# ── Email over SMTP (reset codes by email) ──────────────────────────────
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
#        SMTP_PASS=<a Google "App password" (needs 2-step verification), not your normal password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="OmniBiz <you@example.com>"

# ── Text messages (reset codes by SMS): choose ONE provider ─────────────
# Africa's Talking (works well for Tanzania, Kenya, Uganda, Rwanda…)
SMS_PROVIDER=africastalking
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
# Twilio instead: set SMS_PROVIDER=twilio and fill these in
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
